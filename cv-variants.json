    "projects": {
      "lift": {
        "title": "The Lift Spectrum：鲁棒免成像单像素感知",
        "status": "预印本",
        "role": "第一作者",
        "bullets": [
          "以测量序列到空间任务表征的映射为免成像单像素分割的核心设计问题，设计 STSF 网络与 TPLS 训练调度。",
          "仿真中，3.13% 采样率下前景 mIoU 比 SPIFS 高 3.2–9.9 个百分点；20 dB 信噪比下，较在无噪声数据上训练的最优“先重建再分割”基线高 3.1–21.7 个百分点（无噪声时该基线更优）。"
        ]
      },
      "shsi": {
        "title": "广义稀疏 Hadamard 单像素成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
          "设计稀疏度可调且保持正交的 Hadamard 图案，提出两种无需训练的工作模式并建立噪声理论模型；在信噪比为 20 与 30 dB 的仿真中比传统 Hadamard 图案更抗噪，并经光学实验验证。"
        ]
      },
      "loop": {
        "title": "LDGI：面向光学相控阵线图案照明的循环差分鬼成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
          "针对一维光学相控阵的线图案照明提出循环差分鬼成像，校正其造成的噪声空间不对称；重建质量较传统鬼成像算法提高数个数量级，并以空间光调制器生成的线图案完成光学验证。"
        ]
      }
    },
