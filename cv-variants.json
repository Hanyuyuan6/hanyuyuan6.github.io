    "projects": {
      "lift": {
        "title": "The Lift Spectrum：鲁棒免成像单像素感知",
        "status": "预印本",
        "role": "第一作者",
        "bullets": [
          "无噪声训练、含噪测试下，免成像分割可优于重建后分割；内容自适应一维到二维映射与任务优先损失调度。",
          "在 3.13% 采样率和 20 dB 高斯测量噪声下，三个仿真数据集上的前景平均交并比提高 3.1–21.7 个百分点，并完成光学平台概念验证。"
        ]
      },
      "shsi": {
        "title": "广义稀疏 Hadamard 单像素成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
          "稀疏度可调的 Hadamard 图案保持正交并提高抗噪性；提出两种免训练模式及稀疏度相关噪声模型，经噪声仿真与透过散射介质的光学实验验证。"
        ]
      },
      "loop": {
        "title": "LDGI：面向光学相控阵线图案照明的循环差分鬼成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
          "循环差分鬼成像改善一维光学相控阵线图案成像的噪声对称性；提出噪声对称性指标，经数值仿真与空间光调制器线图案的光学实验验证。"
        ]
      }
    },
