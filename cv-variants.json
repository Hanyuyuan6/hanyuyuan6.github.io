      "lift": {
        "title": "The Lift Spectrum：鲁棒免成像感知",
        "status": "预印本",
        "role": "第一作者",
        "bullets": [
          "揭示去掉重建后，1D 到 2D 的提升（lift）成为核心设计问题，并梳理出 lift 谱系。",
          "提出 STSF + TPLS：比已有免成像方法（SPIFS）高 3.2–9.9 个百分点；采样率降至 0.78% 时精度几乎不变；20 dB 噪声下，比干净数据训练的先重建再分割高达 21.7 个百分点。"
        ]
      },
      "shsi": {
        "title": "稀疏 Hadamard 单像素成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
          "使正交 Hadamard 图案具备可调稀疏性：散射与噪声下稳健成像，低阶矩阵节省存储，无需训练与后处理。"
        ]
      },
      "loop": {
        "title": "LDGI：光学相控阵成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
