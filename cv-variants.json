      "acquisition": {
        "title": "采集条件感知学习与多模态测量接口",
        "status": "研究进行中",
        "role": "研究开发",
        "bullets": [
          "开发面向重建与感知的采集条件感知模型，研究测量预算和采集条件变化下的表征与推断。",
          "将预训练多模态模型适配至桶探测信号，当前开展直接解释桶测量的微调研究。"
        ]
      },
      "lift": {
        "title": "The Lift Spectrum：鲁棒免成像感知",
        "status": "预印本",
        "role": "第一作者",
        "bullets": [
          "揭示去掉重建后，核心设计问题转移到 1D 到 2D 的提升（lift），并把各类 lift 梳理为从固定物理逆变换到内容自适应检索的谱系。",
          "提出 STSF + TPLS：前景 mIoU 比已有免成像方法高 3.2–9.9 个百分点，采样率降至 0.78% 时精度几乎不变；在 20 dB 噪声下，比干净数据训练的先重建再分割高达 21.7 个百分点。"
        ]
      },
      "shsi": {
        "title": "稀疏 Hadamard 单像素成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
          "使正交 Hadamard 图案具备可调稀疏性（两种采集模式与完整理论）：在散射与噪声下稳健成像，低阶矩阵即可高分辨成像、节省存储，且无需训练与后处理。"
        ]
      },
      "loop": {
        "title": "LDGI：光学相控阵成像",
        "status": "已发表",
        "role": "第一作者",
        "bullets": [
          "揭示一维光学相控阵线光场会破坏鬼成像去噪所依赖的噪声对称性；提出循环差分鬼成像（较传统算法提升数个数量级）并完成光学实验验证。"
        ]
      }
